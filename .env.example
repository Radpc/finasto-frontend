# Copy to .env for local development.
# Base URL of the Finasto API (finasto-backend). Only public values belong
# here: everything prefixed VITE_ is bundled into the JavaScript sent to users.
VITE_API_BASE_PATH=http://localhost:3000

# Auth0 sign-in (see finasto-backend/docs/auth0-setup.md). Leave empty to use
# the email and password form against a local API.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
